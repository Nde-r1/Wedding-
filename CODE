    const STORAGE_KEY = "vinceentGraceCreativeRegistryFreshV5";

    let registryData = loadRegistryData();
    let activeGift = null;

    const giftGrid = document.getElementById("giftGrid");
    const searchInput = document.getElementById("searchInput");
    const categoryFilter = document.getElementById("categoryFilter");
    const statusFilter = document.getElementById("statusFilter");
    const giftModal = document.getElementById("giftModal");
    const giftForm = document.getElementById("giftForm");
    const cashGiftForm = document.getElementById("cashGiftForm");
    const toast = document.getElementById("toast");

    function emptyRegistryData() {
      return {
        contributions: [],
        reservations: [],
        cashGifts: []
      };
    }

    function loadRegistryData() {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));

        if (!saved) return emptyRegistryData();

        return {
          contributions: Array.isArray(saved.contributions) ? saved.contributions : [],
          reservations: Array.isArray(saved.reservations) ? saved.reservations : [],
          cashGifts: Array.isArray(saved.cashGifts) ? saved.cashGifts : []
        };
      } catch (error) {
        console.error("Unable to read saved registry data:", error);
        return emptyRegistryData();
      }
    }

    function saveRegistryData() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(registryData));
    }

    function formatMoney(amount) {
      return `${SITE_CONFIG.currency} ${Number(amount).toLocaleString()}`;
    }

    function getGiftContributed(giftId) {
      return registryData.contributions
        .filter(item => item.giftId === giftId)
        .reduce((total, item) => total + Number(item.amount), 0);
    }

    function getGiftStatus(gift) {
      const contributed = getGiftContributed(gift.id);

      if (contributed >= gift.price) return "complete";
      if (contributed > 0) return "partial";
      return "available";
    }

    function populateSiteContent() {
      document.title = `${SITE_CONFIG.coupleName} Wedding Registry`;
      document.getElementById("navCoupleName").textContent = SITE_CONFIG.coupleName;
      document.getElementById("heroCoupleName").textContent = SITE_CONFIG.coupleName;
      document.getElementById("heroMessage").textContent = SITE_CONFIG.heroMessage;
      document.getElementById("storyText").textContent = SITE_CONFIG.story;
      document.getElementById("weddingDetails").textContent = SITE_CONFIG.weddingDetails;
      document.getElementById("paymentDetails").innerHTML = SITE_CONFIG.paymentDetails;
      document.getElementById("footerText").textContent =
        `With love, ${SITE_CONFIG.coupleName} • Thank you for celebrating with us.`;
    }


    function renderCategoryOverview() {
      const overview = document.getElementById("categoryOverview");
      const grouped = GIFTS.reduce((result, gift) => {
        result[gift.category] = (result[gift.category] || 0) + 1;
        return result;
      }, {});

      overview.innerHTML = Object.entries(grouped)
        .map(([category, count]) => `
          <button type="button" onclick="selectCategory('${category.replaceAll("'", "\\'")}')">
            <strong>${category}</strong>
            <span>${count} gift option${count === 1 ? "" : "s"}</span>
          </button>
        `)
        .join("");
    }

    window.selectCategory = function(category) {
      categoryFilter.value = category;
      renderGifts();
      document.getElementById("registry").scrollIntoView({ behavior: "smooth" });
    };

    function populateCategories() {
      const categories = [...new Set(GIFTS.map(gift => gift.category))].sort();

      categories.forEach(category => {
        const option = document.createElement("option");
        option.value = category;
        option.textContent = category;
        categoryFilter.appendChild(option);
      });
    }

    function renderGifts() {
      const term = searchInput.value.trim().toLowerCase();
      const selectedCategory = categoryFilter.value;
      const selectedStatus = statusFilter.value;

      const filteredGifts = GIFTS.filter(gift => {
        const matchesSearch =
          gift.name.toLowerCase().includes(term) ||
          gift.description.toLowerCase().includes(term) ||
          gift.category.toLowerCase().includes(term);

        const matchesCategory =
          selectedCategory === "all" || gift.category === selectedCategory;

        const matchesStatus =
          selectedStatus === "all" || getGiftStatus(gift) === selectedStatus;

        return matchesSearch && matchesCategory && matchesStatus;
      });

      if (!filteredGifts.length) {
        giftGrid.innerHTML = `<div class="empty-state">No gifts match your current search.</div>`;
        updateDashboard();
        return;
      }

      giftGrid.innerHTML = filteredGifts.map(gift => {
        const contributed = getGiftContributed(gift.id);
        const safeContributed = Math.min(contributed, gift.price);
        const remaining = Math.max(gift.price - contributed, 0);
        const percentage = Math.min((contributed / gift.price) * 100, 100);
        const status = getGiftStatus(gift);

        const statusLabel = {
          available: "Available",
          partial: "Partly Funded",
          complete: "Fully Funded"
        }[status];

        return `
          <article class="gift-card">
            <img src="${gift.image}" alt="${gift.name}" loading="lazy"
              onerror="this.src='https://placehold.co/900x600?text=Gift+Image';" />

            <div class="gift-body">
              <div class="gift-topline">
                <div>
                  <h3>${gift.name}</h3>
                  <span class="category">${gift.category}</span>
                  <span class="price-basis">${gift.priceBasis || "Editable estimate"}</span>
                </div>
                <span class="status ${status === "complete" ? "complete" : ""}">
                  ${statusLabel}
                </span>
              </div>

              <p class="gift-description">${gift.description}</p>

              <div class="price-row">
                <span>Gift value</span>
                <strong>${formatMoney(gift.price)}</strong>
              </div>

              <div class="progress">
                <span style="width:${percentage}%"></span>
              </div>

              <div class="progress-text">
                ${formatMoney(safeContributed)} pledged • ${formatMoney(remaining)} remaining
              </div>

              <div class="gift-actions">
                ${
                  status !== "complete"
                    ? `
                      <button class="btn btn-primary btn-small"
                        onclick="openGiftModal(${gift.id}, 'full')">
                        Gift Full Amount
                      </button>

                      <button class="btn btn-outline btn-small"
                        onclick="openGiftModal(${gift.id}, 'contribute')">
                        Contribute
                      </button>

                      <button class="btn btn-outline btn-small"
                        onclick="openGiftModal(${gift.id}, 'reserve')">
                        Reserve
                      </button>
                    `
                    : `
                      <button class="btn btn-outline btn-small" disabled>
                        Thank You — Gift Completed
                      </button>
                    `
                }
              </div>
            </div>
          </article>
        `;
      }).join("");

      updateDashboard();
    }

    window.openGiftModal = function(giftId, action) {
      const gift = GIFTS.find(item => item.id === giftId);
      if (!gift) return;

      activeGift = gift;
      const contributed = getGiftContributed(gift.id);
      const remaining = Math.max(gift.price - contributed, 0);

      document.getElementById("selectedGiftId").value = gift.id;
      document.getElementById("giftAction").value = action;
      document.getElementById("modalTitle").textContent = gift.name;
      document.getElementById("modalRemaining").textContent =
        `${formatMoney(remaining)} remaining`;
      document.getElementById("guestName").value = "";
      document.getElementById("guestMessage").value = "";
      document.getElementById("giftAnonymous").checked = false;

      const amountGroup = document.getElementById("amountGroup");
      const amountInput = document.getElementById("giftAmount");
      const submitButton = document.getElementById("submitGiftButton");

      if (action === "reserve") {
        amountGroup.style.display = "none";
        amountInput.required = false;
        amountInput.value = "";
        submitButton.textContent = "Reserve This Gift";
      } else {
        amountGroup.style.display = "block";
        amountInput.required = true;
        amountInput.max = remaining;

        if (action === "full") {
          amountInput.value = remaining;
          amountInput.readOnly = true;
          submitButton.textContent = "Save Full Gift";
        } else {
          amountInput.value = "";
          amountInput.readOnly = false;
          submitButton.textContent = "Save Contribution";
        }
      }

      giftModal.classList.add("open");
    };

    function closeGiftModal() {
      giftModal.classList.remove("open");
      activeGift = null;
    }

    giftForm.addEventListener("submit", event => {
      event.preventDefault();

      if (!activeGift) return;

      const action = document.getElementById("giftAction").value;
      const name = document.getElementById("guestName").value.trim();
      const message = document.getElementById("guestMessage").value.trim();
      const anonymous = document.getElementById("giftAnonymous").checked;

      if (!name) {
        showToast("Please enter your name.");
        return;
      }

      if (action === "reserve") {
        registryData.reservations.push({
          id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now()),
          giftId: activeGift.id,
          guestName: name,
          displayName: anonymous ? "Anonymous Guest" : name,
          message,
          anonymous,
          createdAt: new Date().toISOString()
        });

        showToast(`${activeGift.name} has been reserved.`);
      } else {
        const amount = Number(document.getElementById("giftAmount").value);
        const remaining = Math.max(activeGift.price - getGiftContributed(activeGift.id), 0);

        if (!amount || amount <= 0) {
          showToast("Enter a valid contribution amount.");
          return;
        }

        if (amount > remaining) {
          showToast(`The maximum remaining amount is ${formatMoney(remaining)}.`);
          return;
        }

        registryData.contributions.push({
          id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now()),
          giftId: activeGift.id,
          guestName: name,
          displayName: anonymous ? "Anonymous Guest" : name,
          amount,
          message,
          anonymous,
          createdAt: new Date().toISOString()
        });

        showToast("Thank you. Your contribution has been recorded.");
      }

      saveRegistryData();
      closeGiftModal();
      renderGifts();
    });

    cashGiftForm.addEventListener("submit", event => {
      event.preventDefault();

      const name = document.getElementById("cashGuestName").value.trim();
      const amount = Number(document.getElementById("cashAmount").value);
      const purpose = document.getElementById("cashPurpose").value;
      const message = document.getElementById("cashMessage").value.trim();
      const anonymous = document.getElementById("cashAnonymous").checked;

      if (!name || !amount || amount <= 0) {
        showToast("Please enter a name and valid amount.");
        return;
      }

      registryData.cashGifts.push({
        id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now()),
        guestName: name,
        displayName: anonymous ? "Anonymous Guest" : name,
        amount,
        purpose,
        message,
        anonymous,
        createdAt: new Date().toISOString()
      });

      saveRegistryData();
      cashGiftForm.reset();
      updateDashboard();
      showToast("Thank you. The cash gift has been recorded.");
    });

    function updateDashboard() {
      const registryValue = GIFTS.reduce((total, gift) => total + gift.price, 0);

      const itemPledges = registryData.contributions.reduce(
        (total, item) => total + Number(item.amount),
        0
      );

      const cashPledges = registryData.cashGifts.reduce(
        (total, item) => total + Number(item.amount),
        0
      );

      const totalPledged = itemPledges + cashPledges;
      const completed = GIFTS.filter(gift => getGiftStatus(gift) === "complete").length;
      const progressPercentage =
        registryValue > 0 ? Math.min((itemPledges / registryValue) * 100, 100) : 0;

      document.getElementById("summaryGiftCount").textContent = GIFTS.length;
      document.getElementById("summaryRegistryValue").textContent = formatMoney(registryValue);
      document.getElementById("summaryPledged").textContent = formatMoney(totalPledged);
      document.getElementById("summaryCompleted").textContent = completed;
      document.getElementById("overallProgressText").textContent =
        `${Math.round(progressPercentage)}% complete`;
      document.getElementById("overallProgressBar").style.width =
        `${progressPercentage}%`;

      const journeyMessage = document.getElementById("journeyMessage");

      if (progressPercentage === 0) {
        journeyMessage.textContent =
          "Our wishlist is ready for your thoughtful blessings.";
      } else if (progressPercentage < 50) {
        journeyMessage.textContent =
          "Our new beginning is taking shape, one thoughtful gift at a time.";
      } else if (progressPercentage < 100) {
        journeyMessage.textContent =
          "We are more than halfway there. Your kindness means so much to us.";
      } else {
        journeyMessage.textContent =
          "Our registry is complete. Thank you for filling our new chapter with love.";
      }
    }

    function startCountdown() {
      const weddingTime = new Date(SITE_CONFIG.weddingDate).getTime();

      function update() {
        const distance = weddingTime - Date.now();

        if (distance <= 0) {
          document.getElementById("days").textContent = "0";
          document.getElementById("hours").textContent = "0";
          document.getElementById("minutes").textContent = "0";
          document.getElementById("seconds").textContent = "0";
          return;
        }

        document.getElementById("days").textContent =
          Math.floor(distance / (1000 * 60 * 60 * 24));

        document.getElementById("hours").textContent =
          Math.floor((distance / (1000 * 60 * 60)) % 24);

        document.getElementById("minutes").textContent =
          Math.floor((distance / (1000 * 60)) % 60);

        document.getElementById("seconds").textContent =
          Math.floor((distance / 1000) % 60);
      }

      update();
      setInterval(update, 1000);
    }

    function showToast(message) {
      toast.textContent = message;
      toast.classList.add("show");

      window.clearTimeout(showToast.timer);
      showToast.timer = window.setTimeout(() => {
        toast.classList.remove("show");
      }, 3200);
    }

    searchInput.addEventListener("input", renderGifts);
    categoryFilter.addEventListener("change", renderGifts);
    statusFilter.addEventListener("change", renderGifts);
    document.getElementById("closeModal").addEventListener("click", closeGiftModal);

    giftModal.addEventListener("click", event => {
      if (event.target === giftModal) closeGiftModal();
    });

    document.addEventListener("keydown", event => {
      if (event.key === "Escape") closeGiftModal();
    });

    populateSiteContent();
    populateCategories();
    renderCategoryOverview();
    renderGifts();
    startCountdown();
  </script>
</body>
</html>
