<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Our Wedding Gift Registry</title>

  <style>
    :root {
      --primary: #7a3e48;
      --secondary: #d8b89c;
      --background: #fffaf6;
      --surface: #ffffff;
      --text: #2f2929;
      --muted: #756b6b;
      --success: #3f7a58;
      --border: #eaded5;
      --shadow: 0 12px 35px rgba(72, 46, 46, 0.10);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
      background: var(--background);
      line-height: 1.6;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1120px, 92%);
      margin: 0 auto;
    }

    .navbar {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 250, 246, 0.95);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(10px);
    }

    .nav-inner {
      min-height: 68px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      font-weight: 800;
      color: var(--primary);
      font-size: 1.08rem;
    }

    .nav-links {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
      color: var(--muted);
      font-size: 0.94rem;
    }

    .hero {
      min-height: 82vh;
      display: grid;
      place-items: center;
      text-align: center;
      padding: 80px 0;
      background:
        linear-gradient(rgba(65, 31, 36, 0.52), rgba(65, 31, 36, 0.52)),
        url("https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1800&q=85")
        center/cover no-repeat;
      color: white;
    }

    .hero-content {
      max-width: 760px;
    }

    .eyebrow {
      display: inline-block;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(255,255,255,0.16);
      border: 1px solid rgba(255,255,255,0.35);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.78rem;
      font-weight: 700;
    }

    .hero h1 {
      margin: 18px 0 8px;
      font-size: clamp(2.5rem, 7vw, 5.6rem);
      line-height: 1;
      font-family: Georgia, "Times New Roman", serif;
    }

    .hero p {
      font-size: clamp(1rem, 2vw, 1.25rem);
      max-width: 650px;
      margin: 20px auto 28px;
    }

    .countdown {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      margin: 28px 0;
    }

    .countdown div {
      min-width: 86px;
      padding: 12px 14px;
      border-radius: 14px;
      background: rgba(255,255,255,0.14);
      border: 1px solid rgba(255,255,255,0.28);
    }

    .countdown strong {
      display: block;
      font-size: 1.45rem;
    }

    .btn {
      border: 0;
      border-radius: 999px;
      padding: 12px 20px;
      font-weight: 700;
      transition: 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-primary {
      color: white;
      background: var(--primary);
    }

    .btn-light {
      color: var(--primary);
      background: white;
    }

    .btn-outline {
      color: var(--primary);
      background: transparent;
      border: 1px solid var(--primary);
    }

    .btn-small {
      padding: 9px 14px;
      font-size: 0.88rem;
    }

    section {
      padding: 76px 0;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 34px;
    }

    .section-heading h2 {
      margin: 0 0 10px;
      font-family: Georgia, "Times New Roman", serif;
      color: var(--primary);
      font-size: clamp(2rem, 4vw, 3rem);
    }

    .section-heading p {
      margin: 0 auto;
      max-width: 660px;
      color: var(--muted);
    }

    .story-card,
    .cash-card,
    .admin-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 30px;
      box-shadow: var(--shadow);
    }

    .story-card {
      max-width: 850px;
      margin: 0 auto;
      text-align: center;
    }

    .filters {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 12px;
      margin-bottom: 26px;
    }

    .field,
    select,
    textarea {
      width: 100%;
      border: 1px solid var(--border);
      background: white;
      border-radius: 12px;
      padding: 12px 14px;
      outline: none;
    }

    .field:focus,
    select:focus,
    textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(122, 62, 72, 0.12);
    }


    .category-overview {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .category-overview button {
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--surface);
      padding: 20px;
      text-align: left;
      box-shadow: var(--shadow);
      transition: 0.2s ease;
      color: var(--text);
    }

    .category-overview button:hover {
      transform: translateY(-3px);
      border-color: var(--primary);
    }

    .category-overview strong {
      display: block;
      color: var(--primary);
      margin-bottom: 5px;
      font-size: 1rem;
    }

    .category-overview span {
      color: var(--muted);
      font-size: 0.86rem;
    }


    .price-reference-note {
      margin: 0 0 22px;
      padding: 14px 16px;
      border: 1px solid var(--border);
      border-left: 4px solid var(--primary);
      border-radius: 12px;
      background: #fff;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .price-basis {
      display: block;
      margin-top: 5px;
      color: var(--muted);
      font-size: 0.72rem;
    }


    .gift-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .gift-card {
      overflow: hidden;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
    }

    .gift-card img {
      width: 100%;
      height: 210px;
      object-fit: cover;
      background: #f4ece7;
    }

    .gift-body {
      padding: 20px;
      display: flex;
      flex: 1;
      flex-direction: column;
    }

    .gift-topline {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
    }

    .gift-card h3 {
      margin: 0;
      font-size: 1.16rem;
    }

    .category {
      display: inline-block;
      margin-top: 7px;
      color: var(--muted);
      font-size: 0.85rem;
    }

    .status {
      white-space: nowrap;
      border-radius: 999px;
      padding: 6px 10px;
      font-size: 0.72rem;
      font-weight: 800;
      background: #f5e7e9;
      color: var(--primary);
    }

    .status.complete {
      background: #e5f2e9;
      color: var(--success);
    }

    .gift-description {
      color: var(--muted);
      font-size: 0.93rem;
      min-height: 48px;
    }

    .price-row {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      margin: 10px 0 8px;
      font-size: 0.92rem;
    }

    .price-row strong {
      color: var(--primary);
      font-size: 1.05rem;
    }

    .progress {
      height: 10px;
      border-radius: 999px;
      background: #efe6df;
      overflow: hidden;
      margin-bottom: 7px;
    }

    .progress span {
      display: block;
      height: 100%;
      width: 0;
      background: var(--success);
      border-radius: inherit;
    }

    .progress-text {
      color: var(--muted);
      font-size: 0.8rem;
      margin-bottom: 16px;
    }

    .gift-actions {
      margin-top: auto;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .cash-card {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 28px;
      align-items: center;
    }

    .cash-card h3 {
      margin-top: 0;
      color: var(--primary);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 2rem;
    }

    .payment-note {
      padding: 12px 14px;
      border-left: 4px solid var(--secondary);
      background: #fff4eb;
      color: #685b54;
      border-radius: 8px;
      font-size: 0.9rem;
    }


    .section-kicker {
      display: inline-block;
      margin-bottom: 8px;
      color: var(--secondary);
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 0.74rem;
    }

    .journey-card {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at top right, rgba(216, 184, 156, 0.28), transparent 34%),
        var(--surface);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
      box-shadow: var(--shadow);
    }

    .journey-card::before {
      content: "V & G";
      position: absolute;
      right: 24px;
      bottom: -28px;
      color: rgba(122, 62, 72, 0.045);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(5rem, 13vw, 9rem);
      font-weight: 700;
      pointer-events: none;
    }

    .summary-box {
      position: relative;
      z-index: 1;
      min-height: 132px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 20px;
      background: rgba(255, 250, 246, 0.88);
    }

    .summary-box span {
      color: var(--muted);
      font-size: 0.84rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .summary-box strong {
      display: block;
      margin: 5px 0 3px;
      color: var(--primary);
      font-size: clamp(1.25rem, 3vw, 1.65rem);
    }

    .summary-box small {
      color: var(--muted);
      font-size: 0.78rem;
    }

    .overall-progress {
      position: relative;
      z-index: 1;
      margin-top: 26px;
      padding: 24px;
      border-radius: 20px;
      color: white;
      background: linear-gradient(135deg, #6e3540, var(--primary));
    }

    .overall-progress-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 16px;
    }

    .overall-progress-heading span {
      display: block;
      color: rgba(255, 255, 255, 0.78);
      font-size: 0.84rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }

    .overall-progress-heading strong {
      display: block;
      margin-top: 2px;
      font-size: 1.4rem;
    }

    .heart-mark {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 3.2rem !important;
      line-height: 1;
      color: rgba(255, 255, 255, 0.8) !important;
    }

    .journey-progress-track {
      height: 14px;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.18);
    }

    .journey-progress-track span {
      display: block;
      width: 0;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #f3d5bd, #ffffff);
      transition: width 0.45s ease;
    }

    .overall-progress p {
      margin: 12px 0 0;
      color: rgba(255, 255, 255, 0.84);
      font-size: 0.9rem;
    }

    .thank-you-ribbon {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      margin-top: 22px;
      padding: 16px 18px;
      border-top: 1px solid var(--border);
      color: var(--muted);
    }

    .thank-you-ribbon span {
      font-family: Georgia, "Times New Roman", serif;
      font-style: italic;
    }

    .thank-you-ribbon strong {
      color: var(--primary);
      text-align: right;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 22px;
    }

    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      color: var(--muted);
      padding: 40px 20px;
      background: white;
      border-radius: 16px;
      border: 1px dashed var(--border);
    }

    footer {
      text-align: center;
      padding: 30px 20px;
      background: #321f22;
      color: #f7ece6;
    }

    .modal {
      position: fixed;
      inset: 0;
      display: none;
      place-items: center;
      background: rgba(32, 20, 22, 0.72);
      padding: 20px;
      z-index: 100;
    }

    .modal.open {
      display: grid;
    }

    .modal-box {
      width: min(560px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      background: white;
      border-radius: 20px;
      padding: 26px;
      box-shadow: 0 25px 80px rgba(0,0,0,0.28);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 18px;
    }

    .modal-header h3 {
      margin: 0;
      color: var(--primary);
    }

    .close-button {
      border: 0;
      background: #f3e8e2;
      color: var(--primary);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      font-weight: 900;
    }

    .form-group {
      margin-bottom: 14px;
    }

    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-weight: 700;
      font-size: 0.9rem;
    }

    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 12px 0;
    }

    .toast {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 200;
      max-width: 340px;
      padding: 14px 18px;
      border-radius: 12px;
      background: #2d5039;
      color: white;
      box-shadow: var(--shadow);
      display: none;
    }

    .toast.show {
      display: block;
    }


    .small-note {
      color: var(--muted);
      font-size: 0.86rem;
    }

    @media (max-width: 900px) {
      .gift-grid,
      .category-overview {
        grid-template-columns: repeat(2, 1fr);
      }

      .cash-card,
      .filters {
        grid-template-columns: 1fr;
      }

      .summary-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 620px) {
      .nav-links {
        display: none;
      }

      .gift-grid,
      .summary-grid,
      .category-overview {
        grid-template-columns: 1fr;
      }

      .hero {
        min-height: 74vh;
      }

      .gift-actions .btn {
        width: 100%;
      }

      .journey-card {
        padding: 22px;
      }

      .thank-you-ribbon {
        align-items: flex-start;
        flex-direction: column;
      }

      .thank-you-ribbon strong {
        text-align: left;
      }
    }
  </style>
</head>

<body>
  <nav class="navbar">
    <div class="container nav-inner">
      <a class="brand" href="#home" id="navCoupleName">Our Wedding</a>
      <div class="nav-links">
        <a href="#story">Our Story</a>
        <a href="#categories">Categories</a>
        <a href="#registry">Gift Registry</a>
        <a href="#cash-gift">Cash Gift</a>
        <a href="#progress">Gift Progress</a>
      </div>
    </div>
  </nav>

  <header class="hero" id="home">
    <div class="container hero-content">
      <span class="eyebrow">We are getting married</span>
      <h1 id="heroCoupleName">Vinceent & Grace</h1>
      <p id="heroMessage">
        Your presence is our greatest gift. For those who wish to bless our new beginning,
        we have prepared this simple wedding gift registry.
      </p>

      <div class="countdown" aria-label="Wedding countdown">
        <div><strong id="days">0</strong><span>Days</span></div>
        <div><strong id="hours">0</strong><span>Hours</span></div>
        <div><strong id="minutes">0</strong><span>Minutes</span></div>
        <div><strong id="seconds">0</strong><span>Seconds</span></div>
      </div>

      <a href="#registry" class="btn btn-light">View Our Wishlist</a>
    </div>
  </header>

  <main>
    <section id="story">
      <div class="container">
        <div class="section-heading">
          <h2>Our Story</h2>
          <p>A few words about the journey that brought us here.</p>
        </div>

        <div class="story-card">
          <p id="storyText">
            We are grateful for the love, prayers and support that have carried us to this
            beautiful moment. As we begin our life together, every gift and kind message will
            help us create a warm and joyful home.
          </p>
          <p><strong id="weddingDetails">Saturday, 12 December 2026 • Nairobi, Kenya</strong></p>
        </div>
      </div>
    </section>


    <section id="categories">
      <div class="container">
        <div class="section-heading">
          <h2>Browse Gift Categories</h2>
          <p>Choose a category to quickly view the gifts available in that section.</p>
        </div>
        <div class="category-overview" id="categoryOverview"></div>
      </div>
    </section>

    <section id="registry">
      <div class="container">
        <div class="section-heading">
          <h2>Wedding Gift Registry</h2>
          <p>Select a full gift, contribute toward a larger item, or reserve an item to deliver later.</p>
        </div>


        <div class="price-reference-note">
          <strong>Pricing reference:</strong> Retail-item prices were aligned to sampled Carrefour Kenya listings checked on 3 August 2026. Prices can change with stock, branch and promotions. Services, funds and furniture not consistently listed by Carrefour remain editable estimates.
        </div>

        <div class="filters">
          <input class="field" id="searchInput" type="search" placeholder="Search gifts..." />
          <select id="categoryFilter">
            <option value="all">All categories</option>
          </select>
          <select id="statusFilter">
            <option value="all">All statuses</option>
            <option value="available">Available</option>
            <option value="partial">Partly funded</option>
            <option value="complete">Fully funded</option>
          </select>
        </div>

        <div class="gift-grid" id="giftGrid"></div>
      </div>
    </section>

    <section id="cash-gift">
      <div class="container">
        <div class="cash-card">
          <div>
            <h3>Send a General Cash Gift</h3>
            <p>
              Guests who prefer not to select an item can make a general contribution toward
              our new home, honeymoon or future plans.
            </p>
            <div class="payment-note" id="paymentDetails">
              M-Pesa Till/Paybill: Add your details here.<br />
              Account Name: Add the couple's name.
            </div>
          </div>

          <form id="cashGiftForm">
            <div class="form-group">
              <label for="cashGuestName">Your name</label>
              <input class="field" id="cashGuestName" required />
            </div>

            <div class="form-group">
              <label for="cashAmount">Amount (KSh)</label>
              <input class="field" id="cashAmount" type="number" min="1" required />
            </div>

            <div class="form-group">
              <label for="cashPurpose">Gift purpose</label>
              <select id="cashPurpose">
                <option>General wedding gift</option>
                <option>New home fund</option>
                <option>Honeymoon fund</option>
                <option>Charity contribution</option>
              </select>
            </div>

            <div class="form-group">
              <label for="cashMessage">Message to the couple</label>
              <textarea id="cashMessage" rows="3" placeholder="Congratulations..."></textarea>
            </div>

            <label class="checkbox-row">
              <input id="cashAnonymous" type="checkbox" />
              Display this gift as anonymous
            </label>

            <button class="btn btn-primary" type="submit">Record Cash Gift</button>
          </form>
        </div>
      </div>
    </section>

    <section id="progress">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker">A new beginning</span>
          <h2>Our Gift Journey</h2>
          <p>
            Every contribution brings us one step closer to building a warm and beautiful
            home together. Thank you for being part of our story.
          </p>
        </div>

        <div class="journey-card">
          <div class="summary-grid">
            <div class="summary-box">
              <span>Wishlist Items</span>
              <strong id="summaryGiftCount">0</strong>
              <small>Thoughtfully selected gifts</small>
            </div>

            <div class="summary-box">
              <span>Registry Value</span>
              <strong id="summaryRegistryValue">KSh 0</strong>
              <small>Total value of our wishlist</small>
            </div>

            <div class="summary-box">
              <span>Gift Contributions</span>
              <strong id="summaryPledged">KSh 0</strong>
              <small>Kindly pledged by our guests</small>
            </div>

            <div class="summary-box">
              <span>Completed Wishes</span>
              <strong id="summaryCompleted">0</strong>
              <small>Fully gifted items</small>
            </div>
          </div>

          <div class="overall-progress">
            <div class="overall-progress-heading">
              <div>
                <span>Overall registry progress</span>
                <strong id="overallProgressText">0% complete</strong>
              </div>
              <span class="heart-mark" aria-hidden="true">♡</span>
            </div>

            <div class="journey-progress-track" aria-label="Overall registry progress">
              <span id="overallProgressBar"></span>
            </div>

            <p id="journeyMessage">
              Our wishlist is ready for your thoughtful blessings.
            </p>
          </div>

          <div class="thank-you-ribbon">
            <span>With grateful hearts</span>
            <strong>Thank you for celebrating with Vinceent &amp; Grace</strong>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <p id="footerText">With love, Vinceent & Grace • Thank you for celebrating with us.</p>
  </footer>

  <div class="modal" id="giftModal" role="dialog" aria-modal="true">
    <div class="modal-box">
      <div class="modal-header">
        <div>
          <h3 id="modalTitle">Gift Item</h3>
          <div class="small-note" id="modalRemaining"></div>
